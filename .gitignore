# Local data (the server's nightly run or your own export) stays out of Git
daten/
*.db
*.db.neu
# Exception: the team copy of the data (eBay figures, without costs or customers) is deliberately in the repository
!daten-team/
!daten-team/pm.db
# Secrets
.env
# Node
node_modules/
# Runtime
*.log
pm.pid
# Exclude every variant of .env (e.g. .env.local); only the template stays
.env.*
!.env.beispiel
