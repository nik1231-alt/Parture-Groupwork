# Copy this file to .env. The .env is never committed.
# (Some variable names are German, e.g. EBAY_SCHREIBEN = "eBay writing", EBAY_WERBUNG = "ads", EBAY_PREIS = "price".
#  The code reads them by these names, so they are kept.)
PM_PORT=5070
# Path to the whitelist database. Leave EMPTY locally: the app then uses daten/pm.db (your own export) or else the team copy
# daten-team/pm.db from the repository. (On the server: C:\parture-pm\daten\pm.db, rebuilt every night at 04:30)
PM_DB=
# Server only: live data from the hub (GET http://127.0.0.1:5050/api/pm/katalog). Leave empty locally.
HUB_URL=
PM_TOKEN=
# Server only, behind Cloudflare Access: team domain (xxx.cloudflareaccess.com) and the AUD of the Access application.
# Leave empty locally; the app is then reachable without that check (127.0.0.1 only).
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# --- eBay API: ADMIN ONLY (Niko), only locally and on the server, NEVER in the repository ---
# The group does not get these values. It works with pm.db and the server endpoints.
# Enter real values only in your own .env (it is git-ignored), never in this template.
EBAY_ENV=PRODUCTION
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
EBAY_REFRESH_TOKEN=

# --- Writing to eBay and the automatic traffic import (only the admin computer with the eBay keys) ---
# Changing titles on eBay needs an admin's approval AND EBAY_SCHREIBEN=an. Without the switch there is only a dry run.
EBAY_SCHREIBEN=
# Daily traffic import (runs inside the server): an = switch on. Only finished days are used (delay in days).
EBAY_TRAFFIC_AUTO=
TRAFFIC_VERZOEGERUNG_TAGE=3
TRAFFIC_UHRZEIT=5

# --- Operation on the server (see docs/server-einrichtung.md) ---
# Which environment is this? prod (server with eBay keys) | vorschau (preview server without keys) | empty = local. Shown as a badge at the top of the app.
PM_UMGEBUNG=
# Public address of this environment (only for links in notifications), e.g. https://app.example.com
APP_URL=
# Telegram notification to the admin (PROD only): a new proposal is waiting, an import or backup failed. Both empty = off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Daily backup of app.db and traffic-tage.db. Default: on, 3 a.m., keep 14 backups in daten/sicherung.
# SICHERUNG_ZIEL2: a second folder on another drive or in a cloud folder; it gets every backup as well.
SICHERUNG_AUTO=
SICHERUNG_UHRZEIT=3
SICHERUNG_BEHALTEN=14
SICHERUNG_ORDNER=
SICHERUNG_ZIEL2=

# --- The ladder (see the README, section "The funnel") ---
# AI titles (phase 1): key for the Google Gemini API, only in the server's .env, never in the repository. Empty = suggestions only from the title help.
GOOGLE_API_KEY=
# Model for the title suggestions (empty = gemini-3.5-flash)
KI_MODELL=
# Ads (phase 2) and price (phase 3) cost money or margin: each has its own switch IN ADDITION to EBAY_SCHREIBEN.
# Without the switch an approval is a dry run. Ads need the sell.marketing permission on the eBay access.
EBAY_WERBUNG=
EBAY_PREIS=
# Optional: a fixed eBay campaign for the ads; empty = the app looks for or creates "Parture Ladder" (cost only on sale)
EBAY_KAMPAGNE_ID=
# Daily run of the ladder (evaluates, takes in new listings, suggests titles; changes nothing on eBay). aus = switch off.
LEITER_AUTO=
LEITER_UHRZEIT=6
