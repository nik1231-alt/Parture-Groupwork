# Kopie als .env anlegen. Die .env wird nie committet.
PM_PORT=5060
# Pfad zur Whitelist-Datenbank (auf dem Server: C:\parture-pm\daten\pm.db, wird nachts 04:30 neu gebaut)
PM_DB=daten/pm.db
# Nur auf dem Server: Live-Daten vom Hub (GET http://127.0.0.1:5050/api/pm/katalog). Lokal leer lassen.
HUB_URL=
PM_TOKEN=
# Nur auf dem Server hinter Cloudflare Access: Team-Domain (xxx.cloudflareaccess.com) und die AUD der Access-Anwendung.
# Lokal leer lassen, dann ist die App ohne Login erreichbar (nur 127.0.0.1).
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# --- eBay-API: NUR Admin (Niko), nur lokal und auf dem Server, NIE im Repo ---
# Die Gruppe bekommt diese Werte nicht. Sie arbeitet mit pm.db und den Server-Endpunkten.
# Echte Werte nur in der eigenen .env eintragen (ist git-ignoriert), nie hier in der Vorlage.
EBAY_ENV=PRODUCTION
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
EBAY_REFRESH_TOKEN=
