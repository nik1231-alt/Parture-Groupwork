# Kopie als .env anlegen. Die .env wird nie committet.
PM_PORT=5070
# Pfad zur Whitelist-Datenbank (auf dem Server: C:\parture-pm\daten\pm.db, wird nachts 04:30 neu gebaut)
PM_DB=daten/pm.db
# Nur auf dem Server: Live-Daten vom Hub (GET http://127.0.0.1:5050/api/pm/katalog). Lokal leer lassen.
HUB_URL=
PM_TOKEN=
# Nur auf dem Server hinter Cloudflare Access: Team-Domain (xxx.cloudflareaccess.com) und die AUD der Access-Anwendung.
# Lokal leer lassen, dann ist die App ohne Login erreichbar (nur 127.0.0.1).
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# --- eBay-API: NUR Admin (Niko), nur lokal und auf dem Server, NIE im Repo ---
# Die Gruppe bekommt diese Werte nicht. Sie arbeitet mit pm.db und den Server-Endpunkten.
# Echte Werte nur in der eigenen .env eintragen (ist git-ignoriert), nie hier in der Vorlage.
EBAY_ENV=PRODUCTION
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
EBAY_REFRESH_TOKEN=

# --- Schreiben und automatischer Traffic-Import (nur Admin-Rechner mit den eBay-Keys) ---
# Titel bei eBay ändern: erst nach Freigabe durch einen Admin UND nur mit EBAY_SCHREIBEN=an. Ohne den Schalter gibt es nur einen Probelauf.
EBAY_SCHREIBEN=
# Täglicher Traffic-Import (läuft im Server): an = einschalten. Es werden nur fertige Tage genutzt (Verzögerung in Tagen).
EBAY_TRAFFIC_AUTO=
TRAFFIC_VERZOEGERUNG_TAGE=3
TRAFFIC_UHRZEIT=5

# --- Betrieb auf dem Server (siehe docs/server-einrichtung.md) ---
# Welche Umgebung ist das? prod (Server mit eBay-Keys) | vorschau (Server ohne Keys) | leer = lokal. Erscheint als Hinweis oben in der App.
PM_UMGEBUNG=
# Öffentliche Adresse dieser Umgebung (nur für Links in Benachrichtigungen), z. B. https://app.example.com
APP_URL=
# Telegram-Benachrichtigung an den Admin (nur PROD): neuer Vorschlag wartet, Import oder Sicherung fehlgeschlagen. Beides leer = aus.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Tägliche Sicherung von app.db und traffic-tage.db. Standard: an, 3 Uhr, 14 Sicherungen in daten/sicherung.
# SICHERUNG_ZIEL2: zweiter Ordner auf einem anderen Laufwerk oder in einer Cloud-Ablage, bekommt jede Sicherung zusätzlich.
SICHERUNG_AUTO=
SICHERUNG_UHRZEIT=3
SICHERUNG_BEHALTEN=14
SICHERUNG_ORDNER=
SICHERUNG_ZIEL2=

# --- Leiter (siehe README, Abschnitt „Leiter“) ---
# KI-Titel (Stufe 1): Schlüssel für die Claude-API, nur in der .env des Servers, nie im Repo. Leer = Vorschläge nur aus der Titelhilfe.
ANTHROPIC_API_KEY=
# Modell für die Titelvorschläge (leer = claude-opus-5-5)
KI_MODELL=
# Werbung (Stufe 2) und Preis (Stufe 3) kosten Geld bzw. Marge: je ein eigener Schalter ZUSÄTZLICH zu EBAY_SCHREIBEN.
# Ohne den Schalter ist die Freigabe ein Probelauf. Werbung braucht beim eBay-Zugang die Berechtigung sell.marketing.
EBAY_WERBUNG=
EBAY_PREIS=
# Optional: feste eBay-Kampagne für die Werbung; leer = die App sucht bzw. legt „Parture Ladder“ (Kosten nur bei Verkauf) an
EBAY_KAMPAGNE_ID=
# Täglicher Lauf der Leiter (wertet aus, nimmt auf, schlägt Titel vor; ändert nichts bei eBay). aus = abschalten.
LEITER_AUTO=
LEITER_UHRZEIT=6
