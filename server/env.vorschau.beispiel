# PREVIEW (vorschau): copy to <preview-folder>\.env. NO eBay keys, no write switch, no Telegram. Nothing can be changed on eBay here.
PM_PORT=5071
PM_UMGEBUNG=vorschau
APP_URL=https://vorschau.YOUR-DOMAIN.com

CF_ACCESS_TEAM_DOMAIN=YOUR-TEAM.cloudflareaccess.com
# Its own Access application, its own AUD (not the one of PROD)
CF_ACCESS_AUD=

# Data: the preview reads the file from PROD (read-only), so the figures are the same there. Without this line it uses the team copy in the repository.
