# VORSCHAU: kopieren nach <vorschau-ordner>\.env. KEINE eBay-Keys, kein Schreibschalter, kein Telegram. Hier kann nichts bei eBay geändert werden.
PM_PORT=5071
PM_UMGEBUNG=vorschau
APP_URL=https://vorschau.DEINE-DOMAIN.de

CF_ACCESS_TEAM_DOMAIN=DEIN-TEAM.cloudflareaccess.com
# Eigene Access-Anwendung, eigene AUD (nicht die von PROD)
CF_ACCESS_AUD=

# Daten: Die Vorschau liest die Datei von PROD (nur lesend), dann sind die Zahlen dort dieselben. Ohne diese Zeile nutzt sie die Team-Kopie im Repo.
# PM_DB=C:\parture\prod\daten\pm.db
