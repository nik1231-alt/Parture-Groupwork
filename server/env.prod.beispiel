# PROD: copy to <prod-folder>\.env and fill in. The .env is never committed. Server only; only Niko has access to this file.
PM_PORT=5070
PM_UMGEBUNG=prod
APP_URL=https://app.YOUR-DOMAIN.com

# Cloudflare Access (mandatory once the tunnel runs): without a valid token the app answers 401
CF_ACCESS_TEAM_DOMAIN=YOUR-TEAM.cloudflareaccess.com
CF_ACCESS_AUD=

# eBay (account partureshop). Enter values only here.
EBAY_ENV=PRODUCTION
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
EBAY_REFRESH_TOKEN=
# Leave EMPTY at first = dry run (nothing is changed on eBay). Set it to "an" (on) only after the dry run.
EBAY_SCHREIBEN=

# Daily traffic import from 5 a.m., only finished days (3 days delay)
EBAY_TRAFFIC_AUTO=an
TRAFFIC_VERZOEGERUNG_TAGE=3
TRAFFIC_UHRZEIT=5

# Message to Niko (Telegram) when a proposal is waiting or something fails
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Daily backup (3 a.m.), additionally into a second folder on another drive or in a cloud folder
SICHERUNG_ZIEL2=
