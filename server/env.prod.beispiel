# PROD: kopieren nach <prod-ordner>\.env und ausfüllen. Die .env wird nie committet. Nur auf dem Server, nur Niko hat Zugriff auf diese Datei.
PM_PORT=5070
PM_UMGEBUNG=prod
APP_URL=https://app.DEINE-DOMAIN.de

# Cloudflare Access (Pflicht, sobald der Tunnel läuft): ohne gültiges Token antwortet die App mit 401
CF_ACCESS_TEAM_DOMAIN=DEIN-TEAM.cloudflareaccess.com
CF_ACCESS_AUD=

# eBay (Konto partureshop). Werte nur hier eintragen.
EBAY_ENV=PRODUCTION
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
EBAY_REFRESH_TOKEN=
# Am Anfang LEER lassen = Probelauf (nichts wird bei eBay geändert). Erst nach dem Probelauf auf "an" stellen.
EBAY_SCHREIBEN=

# Täglicher Traffic-Import ab 5 Uhr, nur fertige Tage (3 Tage Verzögerung)
EBAY_TRAFFIC_AUTO=an
TRAFFIC_VERZOEGERUNG_TAGE=3
TRAFFIC_UHRZEIT=5

# Meldung an Niko (Telegram), wenn ein Vorschlag wartet oder etwas fehlschlägt
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Tägliche Sicherung (3 Uhr), zusätzlich in einen zweiten Ordner auf einem anderen Laufwerk bzw. in eine Cloud-Ablage
SICHERUNG_ZIEL2=
